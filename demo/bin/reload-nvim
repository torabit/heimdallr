#!/bin/sh
# `:colorscheme vanadis` in the running nvim, with every one of its file descriptors off the
# terminal. The redirection is what this file exists for.
#
# vanadis's own demo calls `nvim --server … --remote-send` straight from config.toml, and
# there it works, because `vanadis cycle` is typed and runs in the foreground. Here the same
# command is a descendant of `heimdallr watch &`, which is a background process group, and
# nvim's remote client touches the terminal it was handed. A background process group that
# does that gets SIGTTOU, which stops the whole job:
#
#   [1]+  Stopped     heimdallr watch --interval 1 --on-change 'vanadis apply --variant "$1"'
#
# and heimdallr never polls again. It is stopped by its first run, at start, so the recording
# shows a watcher that answers nothing and a theme that never follows. Nothing says why:
# heimdallr prints nothing on success, and bash reports a stopped job at the next prompt
# rather than when it happened, so the notice lands under a later command.
#
# Measured rather than guessed at. With job control on and a live demo session,
# `nvim --server … --remote-send` alone leaves its job in state `T`, and the same command
# with its output redirected leaves it `Done`.
set -eu
exec nvim --server demo/home/nvim.sock --remote-send '<Esc>:colorscheme vanadis<CR>' \
  >/dev/null 2>&1 </dev/null
