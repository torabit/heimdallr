# Generated by vanadis. Edit templates/starship/starship.toml.in.
#
# starship re-reads this on every prompt, so the prompt is themed the moment the file is
# written. No reload command exists for it because none is needed.
#
# Copied from vanadis's demo/ without `$git_branch` and `$git_status`. They put the
# recorder's branch in the prompt, and the branch this GIF gets recorded on is
# `torabit/docs/demo-gif`: 43 columns of prompt, which wrapped every recorded command onto
# a second line. A committed GIF whose layout depends on the branch it was recorded from
# cannot be re-recorded to look the same, so the prompt is `$directory` and `$character`,
# which is stable and still two themed colours.
#
# `truncation_length` is 1 rather than vanadis's 2 for the same reason: every column the
# prompt does not take is a column the recording can spend on font size instead, and the
# longest line on screen is a command and not the prompt.

"$schema" = 'https://starship.rs/config-schema.json'

format = """
$directory\
$cmd_duration\
$character"""

add_newline = false
palette = "vanadis"

[palettes.vanadis]
accent = "{{role.accent}}"
accent-alt = "{{role.accent-alt}}"
accent-warm = "{{role.accent-warm}}"
comment = "{{role.comment}}"
error = "{{role.error}}"
ok = "{{role.ok}}"
visual = "{{role.visual}}"

[directory]
style = "visual bold"
format = "[$path]($style) "
truncation_length = 1
truncate_to_repo = false

[cmd_duration]
format = "[$duration]($style) "
style = "accent-alt"

[character]
success_symbol = "[❯](accent)"
error_symbol = "[❯](error)"
